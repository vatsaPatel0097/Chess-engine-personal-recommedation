# Stockfish path - update this to your local Stockfish executable
STOCKFISH_PATH=C:\stockfish\stockfish-windows-x86-64-avx2.exe

# OpenAI API key (optional - if not set, uses template-based explanations)
OPENAI_API_KEY=

# LLM model to use
LLM_MODEL=gpt-4o-mini

# Analysis depth (higher = slower but more accurate)
ANALYSIS_DEPTH=15

# Centipawn loss thresholds
BLUNDER_THRESHOLD=300
MISTAKE_THRESHOLD=100
INACCURACY_THRESHOLD=50
